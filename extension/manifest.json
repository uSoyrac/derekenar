{
  "manifest_version": 3,
  "name": "Derkenar: okurken kaydet",
  "short_name": "Derkenar",
  "version": "0.1.0",
  "description": "Web sayfasında ya da Chrome'da açtığın PDF'te seçtiğin metni Derkenar kütüphanene kaydeder.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["contextMenus", "storage", "scripting", "sidePanel", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Derkenar yan panelini aç" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "commands": {
    "save-selection": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Seçili metni Derkenar'a kaydet"
    }
  },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
